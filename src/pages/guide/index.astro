---
// /guide/ (placeholder for phase 1): the h1 from content and the page's anchors.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage, getBlock, pageBlocks } from '../../lib/content';

const page = getPage('guide');
const hero = getBlock(page, 'hero');
---

<BaseLayout page={page} current="/guide/">
  <div class="wrap pt-5">
    <h1>{hero.heading}</h1>
  </div>
  {pageBlocks(page).filter((b) => b.anchor).map((b) => <div id={b.anchor} />)}
</BaseLayout>
