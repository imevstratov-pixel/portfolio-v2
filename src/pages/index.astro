---
// Home page (placeholder for phase 1): the h1 from content and the page's
// anchors. Page builders replace the body with the real blocks.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, getBlock, pageBlocks } from '../lib/content';

const page = getPage('home');
const hero = getBlock(page, 'hero');
---

<BaseLayout page={page} current="/">
  <div class="wrap pt-5">
    <h1>{hero.headline}</h1>
  </div>
  {pageBlocks(page).filter((b) => b.anchor).map((b) => <div id={b.anchor} />)}
</BaseLayout>
