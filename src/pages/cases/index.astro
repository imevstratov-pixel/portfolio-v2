---
// /cases/: intro, table of contents by service, every published case as an
// article with its anchor (the order of render_cases() in the texts
// renderer), the contact block. Blocks are rendered in content order.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import CasesToc from '../../components/cases/CasesToc.astro';
import CaseArticle from '../../components/cases/CaseArticle.astro';
import { cases, getPage, pageBlocks } from '../../lib/content';

const page = getPage('cases');
const blocks = pageBlocks(page);
---

<BaseLayout page={page} current="/cases/">
  {
    blocks.map((b) => {
      if (b.type === 'intro') {
        return (
          <Section rule="none" pad="s4" class="cases-intro">
            <h1>{b.heading}</h1>
            {b.lead && <p class="lead mt-3">{b.lead}</p>}
          </Section>
        );
      }
      if (b.type === 'cases-toc') return <CasesToc block={b} />;
      if (b.type === 'cases-list') {
        return (
          <div class="cases-list">
            {cases.map((c) => (
              <CaseArticle
                case={c}
                sections={b.sections}
                labels={b.labels}
                serviceLinkLabel={b.serviceLinkLabel}
                status={!!b.statusField}
              />
            ))}
          </div>
        );
      }
      if (b.type === 'contact') return <ContactBlock block={b} />;
      return null;
    })
  }
</BaseLayout>
