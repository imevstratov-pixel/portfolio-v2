---
// One case on /cases/ (block type "cases-list"), anchored by the case anchor
// on the article (its header is always visible, so /cases/#case-… lands on
// the title even while the text is folded).
//
// Decision 10 of 14.10 (less text, more pictures): labels with the status,
// the title, the infographic strip (CaseInfographic: facts, steps, «было —
// стало»), the optional one-line `summary`, then «Что из этого сделаю для
// вас» with the service name linked to /services/. The full text (Контекст,
// Что сделал, Результат) sits in a «Читать кейс полностью» disclosure
// (native details, no animation). After it, in the order of render_case() in
// the texts renderer: the AgentsScheme (staff-c2), the links, the case
// testimonials as a Carousel of cards.
//
// Layout (12 columns from 720px): an ink line on top, the mono labels, the
// title in large type. The infographic and the service line take the full
// width, or columns 1-10 from 1080px (1-9 on tablets) when the case has a
// vertical reel, which then sits in 11-12 (10-12) beside them; the service
// line has its name in 1-3 and the text beside it. Inside the disclosure the sections are rows under
// full-width hairlines, the name in 1-3 and the text in 4-10. Phones: one
// column; a narrow reel (7.5rem) beside the service line.
import CaseLabels from '../CaseLabels.astro';
import Prose from '../Prose.astro';
import Button from '../Button.astro';
import Media from '../Media.astro';
import Carousel from '../Carousel.astro';
import AgentsScheme from '../scheme/AgentsScheme.astro';
import VideoTestimonial from '../VideoTestimonial.astro';
import CaseInfographic from './CaseInfographic.astro';
import {
  caseService,
  findBlock,
  getPage,
  bodySections,
  serviceHref,
  getTestimonial,
  type CaseEntry,
} from '../../lib/content';
import { publicFileExists } from '../../lib/media';

interface Props {
  case: CaseEntry;
  /** Body sections to show, in order (block.sections). */
  sections: string[];
  /** Label fields (block.labels). */
  labels: string[];
  /** Name of the section that links to the service (block.serviceLinkLabel). */
  serviceLinkLabel: string;
  /** Label of the disclosure with the full text (default «Читать кейс полностью»). */
  moreLabel?: string;
  /** Accessible name of the testimonials row (default «Что говорят коллеги»). */
  voicesLabel?: string;
  /** Show the status after the labels (block.statusField is set). */
  status?: boolean;
}

const {
  case: c,
  sections,
  labels,
  serviceLinkLabel,
  moreLabel = 'Читать кейс полностью',
  voicesLabel = 'Что говорят коллеги',
  status = true,
} = Astro.props;
const d = c.data;
const id = d.anchor;
const titleId = `${id}-title`;

const service = caseService(c);
const serviceUrl = serviceHref(service);

const all = bodySections(c, sections);
const story = all.filter((s) => s.title !== serviceLinkLabel);
const offer = all.find((s) => s.title === serviceLinkLabel);

// The service name in the closing line («Разбор курса и пути ученика») becomes the link.
const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const serviceTitle = escapeHtml(service.data.title);
const marker = `«${serviceTitle}»`;
const offerLinked = !!offer && offer.html.includes(marker);
const offerHtml = offer ? offer.html.replace(marker, `«<a href="${serviceUrl}">${serviceTitle}</a>»`) : '';

// Reel: the native player with its poster. Accessible name: the reel's hook
// from the home page if it is listed there, otherwise the case title.
const reel = d.reel && publicFileExists(d.reel.video) ? d.reel : null;
const homeReels = findBlock(getPage('home'), 'reels');
const hook: string | undefined = homeReels?.items?.find((it: { case: string }) => it.case === c.id)?.hook;

// rows of the top block the reel stands beside (infographic, summary, the
// service line): the reel spans exactly these, so no empty row adds a gap
const topRows = (d.infographic ? 1 : 0) + (d.summary ? 1 : 0) + 1;

const links = d.links ?? [];
const voices = (d.testimonials ?? []).map((slug) => getTestimonial(slug));
---

<article id={id} class:list={['case', reel && 'case--reel']} aria-labelledby={titleId}>
  <div class="wrap">
    <div class="case__inner">
      <header class="case__head">
        <CaseLabels case={c} fields={labels} status={status} />
        <h2 id={titleId} class="case__title">{d.title}</h2>
      </header>

      <div class="case__top" style={reel ? `--reel-rows: ${topRows}` : undefined}>
        {
          d.infographic && (
            <div class="case__ig">
              <CaseInfographic infographic={d.infographic} />
            </div>
          )
        }
        {d.summary && <p class="case__summary lead">{d.summary}</p>}
        <div class="case__offer">
          <h3 class="case__offer-title">
            {offerLinked ? serviceLinkLabel : <a href={serviceUrl}>{serviceLinkLabel}</a>}
          </h3>
          {offer && <Prose class="case__offer-text" html={offerHtml} />}
        </div>
        {
          reel && (
            <div class="case__reel">
              <Media type="video" src={reel.video} poster={reel.poster} ratio="9 / 16" label={hook ?? d.title} />
            </div>
          )
        }
      </div>

      {
        story.length > 0 && (
          <details class="disclose case__more">
            <summary>{moreLabel}</summary>
            <div class="case__rows">
              {story.map((s) => (
                <div class="case__row">
                  {s.title && <h3 class="case__label label">{s.title}</h3>}
                  <div class="case__text">
                    <Prose html={s.html} />
                  </div>
                </div>
              ))}
            </div>
          </details>
        )
      }

      {
        d.scheme === 'ai-agents' && (
          <div class="case__block">
            <AgentsScheme idPrefix={`${id}-scheme`} level={3} facts={false} />
          </div>
        )
      }

      {
        links.length > 0 && (
          <ul class="case__links" role="list">
            {links.map((l) => (
              <li>
                <Button href={l.url} size="small">
                  {l.label}
                </Button>
                {l.note && <span class="label">{l.note}</span>}
              </li>
            ))}
          </ul>
        )
      }

      {
        voices.length > 0 && (
          <div class="case__voices">
            <Carousel items={voices} label={voicesLabel} id={`${id}-voices`} bleed>
              {(t: (typeof voices)[number]) => <VideoTestimonial testimonial={t} layout="card" size="medium" />}
            </Carousel>
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .case {
    margin-top: var(--s5);
  }

  .case__inner {
    border-top: var(--line);
    padding-top: var(--s2);
  }

  .case__title {
    margin-top: var(--s2);
    max-width: 22em;
  }

  /* infographic, summary and service line; the reel beside them */
  .case__top {
    margin-top: var(--s4);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--gap);
    row-gap: var(--s3);
    align-items: start;
  }

  .case__ig,
  .case__summary,
  .case__offer,
  .case__reel {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .case__summary {
    max-width: 34em;
  }

  .case__offer {
    display: grid;
    gap: var(--s1);
    padding-top: var(--s2);
    border-top: var(--hair);
  }

  .case__offer-title {
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    letter-spacing: 0;
  }

  .case__offer :global(.case__offer-text) {
    max-width: var(--measure);
  }

  /* phones: a narrow reel beside the service line */
  .case--reel .case__top {
    grid-template-columns: minmax(0, 1fr) 7.5rem;
  }

  .case--reel .case__offer {
    grid-column: 1;
  }

  .case--reel .case__reel {
    grid-column: 2;
    margin-top: calc(var(--s2) + 1px);
  }

  .case__more {
    margin-top: var(--s3);
  }

  .case__rows {
    margin-top: var(--s3);
    display: grid;
    row-gap: var(--s3);
  }

  .case__row {
    border-top: var(--hair);
    padding-top: var(--s2);
    display: grid;
    row-gap: var(--s1);
  }

  .case__label {
    color: var(--muted);
  }

  .case__block {
    margin-top: var(--s4);
  }

  .case__links {
    list-style: none;
    padding: 0;
    margin-top: var(--s3);
    display: grid;
    gap: var(--s1);
    justify-items: start;
  }

  .case__links li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s2);
  }

  .case__voices {
    margin-top: var(--s4);
  }

  @media (min-width: 720px) {
    .case__top,
    .case--reel .case__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    /* the service line on the page grid: its name in 1-3, the text beside */
    .case__offer,
    .case--reel .case__offer {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      column-gap: var(--gap);
    }

    .case__offer-title {
      grid-column: 1 / span 3;
    }

    .case__offer :global(.case__offer-text) {
      grid-column: 4 / -1;
      font-size: var(--fs-medium);
      line-height: 1.4;
      letter-spacing: var(--track-medium);
    }

    .case--reel .case__ig,
    .case--reel .case__summary,
    .case--reel .case__offer {
      grid-column: 1 / span 9;
    }

    .case--reel .case__reel {
      grid-column: 10 / span 3;
      grid-row: 1 / span var(--reel-rows, 1);
      margin-top: 0;
    }

    .case__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .case__row > .case__label {
      grid-column: 1 / span 3;
    }

    .case__row > .case__text {
      grid-column: 4 / span 9;
    }
  }

  @media (min-width: 1080px) {
    .case--reel .case__ig,
    .case--reel .case__summary,
    .case--reel .case__offer {
      grid-column: 1 / span 10;
    }

    .case--reel .case__reel {
      grid-column: 11 / span 2;
    }

    .case__row > .case__text {
      grid-column: 4 / span 7;
    }
  }
</style>
