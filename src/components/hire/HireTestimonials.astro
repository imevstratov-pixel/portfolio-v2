---
// «Что говорят коллеги» on /hire/ (block "testimonials", anchor
// #testimonials): the hint under the heading, then one video testimonial per
// row between thin rules, as on the home page (poster 3 of 12 columns, the
// quote beside it on 6 in the medium size; on phones a narrow video
// column). The signature adds the company and the relation from the block
// when they are new and not empty («Женя, CPO, Школа маркетплейсов Лео Шевченко, мой руководитель»).
import Section from '../Section.astro';
import VideoTestimonial from '../VideoTestimonial.astro';
import { getTestimonial, visible, type Block } from '../../lib/content';

interface Props {
  block: Block;
}

type Item = { testimonial: string; company?: string; relation?: string };

const { block: b } = Astro.props;
const items = visible<Item>(b.items)
  .filter((it) => it?.testimonial)
  .map((it) => ({ t: getTestimonial(it.testimonial), extra: [it.company, it.relation] }));
---

{
  items.length > 0 && (
    <Section id={b.anchor} heading={b.heading}>
      {b.hint && <p slot="head" class="ht__hint label">{b.hint}</p>}
      <ul class="ht" role="list">
        {items.map((it) => (
          <li>
            <VideoTestimonial testimonial={it.t} extra={it.extra} size="medium" />
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  .ht__hint {
    margin-top: var(--s2);
  }

  .ht > li {
    padding-block: var(--s3);
    border-top: var(--hair);
  }

  .ht > li:first-child {
    padding-top: var(--s2);
  }

  .ht > li:last-child {
    padding-bottom: 0;
  }
</style>
