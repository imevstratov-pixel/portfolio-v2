---
// First screen of /guide/ (block "hero"): the h1, the lead, the «Гайд»
// Telegram button with its hint and the email line, and the price line.
// The screenshot of the trainer (media) is still pending: while its src is
// empty the text uses the width; once it exists it stands to the right of the
// text from 1080px (a plain rectangle, no phone frame) and under it on phones.
import Section from '../Section.astro';
import Media from '../Media.astro';
import TelegramAction from '../TelegramAction.astro';
import type { Block } from '../../lib/content';

interface Props {
  block: Block;
}

const { block } = Astro.props;
const media = block.media?.src ? block.media : undefined;
---

<Section rule="none" pad="s4" class="hero">
  <div class:list={['grid', 'hero__grid', media && 'hero__grid--media']}>
    <div class="hero__text">
      <h1 class="hero__title">{block.heading}</h1>
      {block.lead && <p class="lead">{block.lead}</p>}
      {
        block.button?.codeword && (
          <TelegramAction codeword={block.button.codeword} hint={!!block.button.hint} email={block.email ?? false} />
        )
      }
      {block.price && <p class="hero__price">{block.price}</p>}
    </div>
    {
      media && (
        <div class="hero__media">
          <Media src={media.src} alt={media.alt} loading="eager" maxWidth="24rem" />
        </div>
      )
    }
  </div>
</Section>

<style>
  .hero__text {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--s3);
  }

  .hero__title {
    max-width: 13em;
    margin-bottom: var(--s1);
  }

  .hero__price {
    max-width: var(--measure);
  }

  @media (min-width: 1080px) {
    .hero__grid--media .hero__text {
      grid-column: 1 / span 7;
    }

    .hero__grid--media .hero__media {
      grid-column: 9 / span 4;
    }
  }
</style>
