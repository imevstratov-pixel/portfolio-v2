---
// One service on /services/, ported from render_service() in the texts
// renderer. Full template: body, «Для кого», «Что получите на руки»,
// «Сколько длится», «Как идёт работа», «Что нужно от вас», «Что не входит»,
// «Нейросеть и расходы», proof («Что можно открыть» and «Что я написал сам»
// for app; otherwise «Чем подтверждено» and «Мои продукты»), «Что говорят
// коллеги», the price line and the Telegram button with hint and email.
// short: the short variant (group «Мост»): «Для кого», «Что получите на
// руки», the «Подробнее…» link, price and button.
//
// Layout: from 1080px number, title and summary in the left 4 columns
// (they stay in view while the text scrolls), the text in the right 8.
// Below 1080px everything stacks. An ink line on top separates services.
import ServicePart from './ServicePart.astro';
import Prose from '../Prose.astro';
import Quote from '../Quote.astro';
import TelegramAction from '../TelegramAction.astro';
import {
  bodyHtml,
  caseHref,
  getService,
  getTestimonial,
  productHref,
  publishedCases,
  testimonialSignature,
  visibleProducts,
  type ServiceEntry,
} from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  service: string | ServiceEntry;
  /** pages/services.md serviceTemplate.labels. */
  labels: Record<string, string>;
  /** Position on the page (1–7), shown as «01». */
  number: number;
  /** Short variant (service-group with variant: short). */
  short?: boolean;
  /** serviceTemplate.button.email (default global.email.line). */
  email?: string;
}

const { service, labels, number, short = false, email } = Astro.props;
const s = typeof service === 'string' ? getService(service) : service;
const d = s.data;
const titleId = `${d.anchor}-title`;
const num = String(number).padStart(2, '0');
const body = short ? '' : bodyHtml(s);

type ProofItem = { title: string; href: string; aside?: string; note?: string };
const ext = (href: string) => /^https?:/i.test(href);
const notes: Record<string, string> = d.proofNotes ?? {};
const caseItems: ProofItem[] = publishedCases(d.proofCases).map((c) => ({
  title: c.data.shortTitle,
  href: caseHref(c),
  note: notes[c.id],
}));
const linkItems: ProofItem[] = (d.proofLinks ?? []).map((l) => ({
  title: l.label,
  href: url(l.url),
  aside: l.note,
}));
const productItems: ProofItem[] = visibleProducts(d.proofProducts).map((p) => ({
  title: p.data.title,
  href: productHref(p),
  note: p.data.oneLiner,
}));
// renderer: slug "app" shows what can be opened first, then what I wrote
const proofGroups: Array<{ label: string; items: ProofItem[] }> = short
  ? []
  : s.id === 'app'
    ? [
        { label: labels.proofLinks, items: linkItems },
        { label: labels.proofCasesBuilt, items: caseItems },
      ]
    : [
        { label: labels.proof, items: [...caseItems, ...linkItems] },
        { label: labels.proofProducts, items: productItems },
      ];
const quotes = short ? [] : (d.testimonials ?? []).map(getTestimonial);
const duration = `${d.duration}.${d.durationNote ? ' ' + d.durationNote : ''}`;
---

<article id={d.anchor} class="svc grid" aria-labelledby={titleId}>
  <header class="svc__head lg-col-4">
    <p class="label svc__num">{num}</p>
    <h3 id={titleId} class="svc__title">{d.title}</h3>
    <p class="svc__summary">{d.summary}</p>
  </header>

  <div class="svc__body lg-col-8">
    {body && <Prose html={body} />}

    <ServicePart label={labels.forWhom}>
      <ul class="list-dash" role="list">{d.forWhom.map((x) => <li>{x}</li>)}</ul>
    </ServicePart>

    <ServicePart label={labels.youGet}>
      <ul class="list-dash" role="list">{d.youGet.map((x) => <li>{x}</li>)}</ul>
    </ServicePart>

    {
      !short && (
        <>
          <ServicePart label={labels.duration}>
            <p class="measure">{duration}</p>
          </ServicePart>

          <ServicePart label={labels.steps}>
            <ol class="list-num" role="list">
              {d.steps.map((x) => (
                <li>{x}</li>
              ))}
            </ol>
          </ServicePart>

          {d.fromYou && (
            <ServicePart label={labels.fromYou}>
              <p class="measure">{d.fromYou}</p>
            </ServicePart>
          )}

          <ServicePart label={labels.notIncluded}>
            <ul class="list-dash" role="list">
              {d.notIncluded.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </ServicePart>

          {d.ai && (
            <ServicePart label={labels.ai}>
              <p class="measure">{d.ai}</p>
            </ServicePart>
          )}

          {proofGroups
            .filter((g) => g.items.length > 0)
            .map((g) => (
              <ServicePart label={g.label}>
                <ul class="proof" role="list">
                  {g.items.map((it) => (
                    <li>
                      <p class="proof__title">
                        <a
                          href={it.href}
                          target={ext(it.href) ? '_blank' : undefined}
                          rel={ext(it.href) ? 'noopener' : undefined}
                        >
                          {it.title}
                        </a>
                        {it.aside && <span class="proof__aside"> ({it.aside})</span>}
                      </p>
                      {it.note && <p class="proof__line">{it.note}</p>}
                    </li>
                  ))}
                </ul>
              </ServicePart>
            ))}

          {quotes.length > 0 && (
            <ServicePart label={labels.testimonials}>
              <div class="quotes">
                {quotes.map((t) => (
                  <Quote text={t.data.quote} cite={testimonialSignature(t)} size="medium" />
                ))}
              </div>
            </ServicePart>
          )}
        </>
      )
    }

    <ServicePart>
      <div class="svc__cta">
        {
          short && d.more && (
            <p class="svc__more">
              <a href={url(d.more.url)}>{d.more.label}</a>
            </p>
          )
        }
        <p class="svc__price">{d.price}.</p>
        <TelegramAction codeword={d.codeword} email={email} />
      </div>
    </ServicePart>
  </div>
</article>

<style>
  .svc {
    padding-top: var(--s2);
    border-top: var(--line);
  }

  .svc__head {
    display: grid;
    align-content: start;
    gap: var(--s2);
  }

  .svc__num {
    margin-bottom: calc(var(--s1) - var(--s2));
  }

  .svc__title {
    max-width: 18em;
  }

  /* the short description in italic (as the texts ask), base size under the
     medium bold title, so the pair reads as title and line */
  .svc__summary {
    font-style: italic;
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    letter-spacing: 0;
    max-width: 34ch;
  }

  @media (min-width: 1080px) {
    .svc__head {
      position: sticky;
      top: calc(var(--header-h) + var(--s3));
      align-self: start;
      padding-right: var(--s3);
    }
  }

  .svc__body {
    display: grid;
    align-content: start;
    gap: var(--s3);
  }

  /* the ink line of the service already sits above the first part */
  .svc__body > :global(.part:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .proof {
    display: grid;
    gap: var(--s2);
    max-width: var(--measure);
  }

  .proof__title {
    font-weight: var(--bold);
  }

  .proof__aside {
    font-weight: var(--regular);
    color: var(--muted);
  }

  .quotes {
    display: grid;
    gap: var(--s3);
  }

  .svc__cta {
    display: grid;
    justify-items: start;
    gap: var(--s2);
  }
</style>
